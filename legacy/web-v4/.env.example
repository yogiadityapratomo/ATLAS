# Salin menjadi web/.env (JANGAN di-commit). Nilai kosong = tidak dipakai.

# 0 = tombol Generate tidak menembak master NBU (disarankan untuk DEV lokal)
# 1 = Generate live ke master NBU (perilaku production)
ATLAS_ALLOW_LIVE_NBU=0

# URL master (opsional; default sama dengan production)
NBU_TBS_URL=https://tbsnbuvpapp1/netbackup
NBU_BSD_URL=https://bsdnbuvpapp1.telkomsel.co.id/netbackup
NBU_BRN_URL=https://brnnbuvpapp1.telkomsel.co.id/netbackup

# API key NetBackup (read-only). Isi hanya jika ATLAS_ALLOW_LIVE_NBU=1
NBU_TBS_TOKEN=
NBU_BSD_TOKEN=
NBU_BRN_TOKEN=
