# ATLAS — salin menjadi .env di root repo (JANGAN di-commit). Dibaca oleh atlas/core/config.py.
# Web V4 lama memakai file terpisah: legacy/web-v4/.env

# ---------------------------------------------------------------- umum
# dev | staging | prod
ATLAS_ENV=dev
# debug | info | warning | error
ATLAS_LOG_LEVEL=info
# Folder log JSON (rotasi harian, simpan 30 hari). Relatif terhadap root repo.
ATLAS_LOG_DIR=logs

# ---------------------------------------------------------------- database (design 03 §7, design 05 §5)
ATLAS_DB_HOST=localhost
ATLAS_DB_PORT=5432
ATLAS_DB_NAME=atlas

# Web: SELECT data dashboard + INSERT audit.event
ATLAS_DB_USER_WEB=atlas_web
ATLAS_DB_PASSWORD_WEB=

# Job/collector: tulis data + INSERT audit.event
ATLAS_DB_USER_APP=atlas_app
ATLAS_DB_PASSWORD_APP=

# Pool koneksi web (design: 2–5) dan batas waktu
ATLAS_DB_POOL_MIN=2
ATLAS_DB_POOL_MAX=5
ATLAS_DB_CONNECT_TIMEOUT_S=5
ATLAS_DB_STATEMENT_TIMEOUT_MS=15000
ATLAS_DB_SLOW_QUERY_MS=500

# ---------------------------------------------------------------- NetBackup
# 0 = tidak pernah menembak master NBU (DEV); 1 = boleh (production, lewat CR)
ATLAS_ALLOW_LIVE_NBU=0
